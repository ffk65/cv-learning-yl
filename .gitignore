# ============================================================
# .gitignore —— 告诉 git 哪些"本地文件"不要上传到 GitHub
# 用法：一行一条规则；以 # 开头的"整行"才是注释（注释不能写在规则后面）
# 原则：数据集 / 训练产物 / 缓存 / 编辑器配置 = 不上传；
#       脚本(.py)、文档(.md)、成果图片 = 上传
# ============================================================

# ---------- 1. 数据集（最大，约 170MB，本地留一份即可）----------
dataset/


# ---------- 2. 训练产物（每次跑都会重新生成，不必上传）----------
# TensorBoard 曲线的事件日志
runs/
# 训练出的模型权重
checkpoints/
# 以后若换别的日志库（保险）
logs/
wandb/

# ---------- 3. Python 缓存（自动生成，传了也没意义）----------
__pycache__/
# 不在 __pycache__ 目录里的单个编译缓存
*.pyc
# 以后若用 Jupyter Notebook，它自动生成的检查点（保险）
.ipynb_checkpoints/
.venv/
env/

# ---------- 4. 模型权重文件（体积大，且可由训练复现）----------
*.pth
# 有些项目用 .pt 后缀（保险）
*.pt
# 以后若导出 ONNX 模型（保险）
*.onnx

# ---------- 5. 编辑器 / 系统杂项 ----------
# VS Code 个人配置（各人不同，不必共享）
.vscode/
# 以后若用 PyCharm（保险）
.idea/
# macOS 自动生成
.DS_Store
# Windows 缩略图缓存
Thumbs.db
# ---------- 6. 文档 ----------(暂时)
README.md

